# Root allowlist: unknown personal files are ignored by default.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/使用说明.md
!/源码/
!/版本归档/
!/vendor/
!/tools/
!/界面预览/
# Never commit exports, backups, preferences, build output or key material.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.build-native/
**/ModuleCache/
**/*.app/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.1pux
**/*.1pif
**/*.age
**/*.zip
**/*.tar.gz
**/*.txt
!**/LICENSE-age.txt
**/settings.plist
**/.env*
**/.keygen.1p-lock/
